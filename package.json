{
  "name": "sprachverstand",
  "version": "0.7.0",
  "private": true,
  "description": "Macht Webseiten leichter lesbar.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node scripts/build.mjs --clean",
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs --target chromium",
    "build:chromium-family": "npm run build:chromium",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "dev": "node scripts/build.mjs --target chromium --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser:chromium": "node scripts/live-browser-smoke.mjs --browser chromium",
    "test:browser:firefox": "node scripts/live-browser-smoke.mjs --browser firefox",
    "test:real-world": "node scripts/real-world-browser-matrix.mjs",
    "validate:real-world": "node scripts/real-world-browser-matrix.mjs --list",
    "check": "npm run audit:public && npm run typecheck && npm run test && npm run validate:real-world && npm run build && npm run validate:icons && npm run validate:locales && npm run validate:store && npm run validate:store-exports && npm run validate:browsers && npm run lint:firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "validate:icons": "node scripts/validate-icons.mjs",
    "validate:browsers": "node scripts/validate-browser-targets.mjs",
    "validate:browsers:gecko": "node scripts/validate-browser-targets.mjs --family gecko",
    "validate:browsers:chromium": "node scripts/validate-browser-targets.mjs --family chromium",
    "audit:public": "node scripts/audit-publication.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:store": "node scripts/validate-store-listings.mjs",
    "store:generate": "node scripts/store-release-notes.mjs && node scripts/generate-store-metadata.mjs && node scripts/generate-chrome-dashboard.mjs",
    "validate:store-exports": "node scripts/store-release-notes.mjs --check && node scripts/generate-store-metadata.mjs --check && node scripts/generate-chrome-dashboard.mjs --check",
    "cws:status": "node scripts/chrome-web-store-v2.mjs status",
    "cws:upload": "node scripts/chrome-web-store-v2.mjs upload",
    "cws:publish": "node scripts/chrome-web-store-v2.mjs publish",
    "store:release-notes": "node scripts/store-release-notes.mjs",
    "amo:profile": "node scripts/amo-api-v5.mjs profile",
    "amo:listing-status": "node scripts/amo-api-v5.mjs listing-status",
    "amo:update-listing": "npm run store:generate && node scripts/amo-api-v5.mjs listing-update",
    "amo:notes": "node scripts/amo-api-v5.mjs notes",
    "amo:submit": "node scripts/amo-api-v5.mjs submit",
    "cws:wait": "node scripts/chrome-web-store-v2.mjs wait",
    "cws:cancel": "node scripts/chrome-web-store-v2.mjs cancel",
    "cws:rollout": "node scripts/chrome-web-store-v2.mjs rollout"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "web-ext": "10.6.0"
  },
  "license": "AGPL-3.0-only"
}
