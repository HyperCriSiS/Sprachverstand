{
  "manifest_version": 3,
  "name": "Sprachverstand",
  "version": "0.2.0",
  "description": "Macht Webseiten wieder lesbar.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Sprachverstand",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
