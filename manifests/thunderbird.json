{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.9.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "de",
  "homepage_url": "https://github.com/HyperCriSiS/Sprachverstand",
  "permissions": ["storage", "scripting", "messagesRead"],
  "optional_permissions": ["compose"],
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird@sprachverstand.hypercrisis",
      "strict_min_version": "128.0"
    }
  },
  "background": {"scripts": ["background.js"]},
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html",
    "default_icon": {"32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "options_ui": {"page": "options/options.html", "open_in_tab": true},
  "icons": {"32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
